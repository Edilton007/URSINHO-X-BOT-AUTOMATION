<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="17dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/brandMark"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_brand_mark"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="UX"
            android:textColor="#06121b"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URSINHO X"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:letterSpacing="0.12"
                android:text="TENANT CONTROL PANEL"
                android:textColor="@color/accent_lilac"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnReload"
            android:layout_width="46dp"
            android:layout_height="44dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/bg_button_secondary"
            android:backgroundTint="@null"
            android:contentDescription="Atualizar portal"
            android:stateListAnimator="@null"
            android:text="↻"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="46dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_secondary"
            android:backgroundTint="@null"
            android:contentDescription="Configurar servidor"
            android:stateListAnimator="@null"
            android:text="⚙"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />
    </LinearLayout>

    <View
        android:id="@+id/auroraAccent"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:alpha="0.88"
        android:background="@drawable/bg_aurora_strip" />

    <ProgressBar
        android:id="@+id/progressLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent_lilac"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_background">

            <WebView
                android:id="@+id/webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/app_background" />

            <LinearLayout
                android:id="@+id/offlinePanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_offline_panel"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="32dp"
                android:paddingBottom="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/bg_brand_mark"
                    android:gravity="center"
                    android:text="UX"
                    android:textColor="#06121b"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="21dp"
                    android:letterSpacing="0.12"
                    android:text="LIGAÇÃO AO BACKEND"
                    android:textColor="@color/accent_lilac"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="O portal está temporariamente indisponível"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtOfflineMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="Verifique a ligação à Internet ou o endereço HTTPS do servidor."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnRetry"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:text="Tentar novamente"
                    android:textAllCaps="false"
                    android:textColor="#06131d"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="URSINHO X BOT AUTOMATION  ·  CLIENT APP"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp"
                    android:letterSpacing="0.04" />
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
