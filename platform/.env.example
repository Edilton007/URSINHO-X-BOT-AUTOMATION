# ============================================================
# URSINHO X BOT V2 — Variáveis de ambiente
#
# Copia este ficheiro para ".env" (no mesmo sítio, raiz do
# projeto) e preenche com os teus valores reais.
# NUNCA envies o ".env" preenchido para o GitHub nem para mim.
# ============================================================

# ---------- OBRIGATÓRIO (sem isto, o bot não arranca) ----------

OWNER=

# Autenticação do painel/API do bot.
API_KEY=
API_PORT=3000
# Em alojamento gerido, usa a variável PORT fornecida pelo painel do host.

# Número para parear o WhatsApp (formato internacional, só
# dígitos, ex: 258871234567). Usado no primeiro arranque/depois
# de perder a sessão.
PAIRING_NUMBER=
# true = mostra só o código (esconde o QR no terminal). false = mostra os dois.
PAIRING_ONLY=false

# ---------- IA (pelo menos uma destas é precisa p/ Chat IA) ----------

# Gemini — já tínhamos pedido para teres 1 chave. Podes
# adicionar várias (GEMINI_API_KEY_2, _3, etc.) para somar cota.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash

# Groq — console.groq.com, grátis, sem cartão.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Claude/Anthropic — opcional, fallback extra.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenRouter — último fallback, opcional.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Busca web em tempo real (clima funciona sem isto; notícias/
# resultados/cotações precisam da Tavily). tavily.com, grátis.
TAVILY_API_KEY=

# ---------- VOZ (.falar, respostas em áudio) ----------

# Mesma chave do Gemini serve para TTS — não precisa de nova.
# ---------- DOWNLOADS (.play, .ytmp3, .ytmp4, Facebook) ----------

# Yoinku — primeira tentativa de download (grátis, limitada).
YOINKU_API_KEY=

# RapidAPI (youtube-mp36) — segunda tentativa, mais robusta.
# rapidapi.com, plano Free.
RAPIDAPI_KEY=

# Cobalt — último fallback de download (opcional).
COBALT_API_URL=

# YouTube Data API oficial (opcional — melhora a busca).
YOUTUBE_API_KEY=

# Caminhos internos (normalmente NÃO precisas de mexer nisto —
# o bot encontra sozinho; só define se o host exigir caminho
# específico).
FFMPEG_PATH=
YTDLP_PATH=
COOKIES_PATH=

# Deixa "off" nesta hospedagem (ver nota no código) — só muda
# para "on" se um dia confirmares que o host alcança o GitHub.
YT_REMOTE_COMPONENTS=off
YT_EXTRACTOR_ARGS=

# ---------- SEGURANÇA DA API DO PAINEL ----------

# Domínios que podem chamar a API do bot (painel admin, etc.).
# Separa por vírgula, sem espaços.
ALLOWED_ORIGINS=

# ---------- VOZ (.falar) ----------
GEMINI_TTS_MODEL=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
TTS_PROVIDERS=gemini,edge  # ElevenLabs é opcional; não é necessário para o modo gratuito
TTS_MAX_CHARS=4500
TTS_CHUNK_CHARS=1800
EDGE_TTS_VOICE=pt-PT-RaquelNeural
GEMINI_TTS_API_KEYS=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---------- DOWNLOADS: AUTO-LIMPEZA E FILA ----------
# Ficheiros baixados são apagados após X horas (24 = 1 dia, 48 = 2 dias)
DOWNLOAD_TTL_HOURS=48
# Temporários (yt-dlp, áudios) apagados após X horas
TMP_TTL_HOURS=3
# Se a pasta downloads passar disto (MB), apaga os mais antigos
DOWNLOAD_MAX_MB=1000
# De quanto em quanto tempo corre a limpeza (minutos)
CLEANUP_INTERVAL_MINUTES=60
CLEANUP_ENABLED=true
# Quantos downloads podem correr ao mesmo tempo
DOWNLOAD_CONCURRENCY=2

# Contacto público do website /site/ (opcional; apenas número público de atendimento).
PUBLIC_CONTACT_NUMBER=

# ---------- URSINHO X BOT AUTOMATION ----------
ADMIN_API_KEY=
AUTOMATION_ALLOW_EXECUTION=false
AUTOMATION_MONITOR_INTERVAL_MS=30000
AUTOMATION_GROUPS_JSON={}
ADMIN_TRUST_PROXY=false
ADMIN_MAX_FALHAS=10
# Bases de dados: preserva o layout histórico do Bot. Mantém estes caminhos estáveis
# ou configura volumes persistentes com migração/validação prévia dos ficheiros.
BOT_DB_FILE=./src/database/db.json
AUTOMATION_DB_FILE=./src/automation/database/automation.json
AUTOMATION_ORDERS_FILE=./src/database/automationOrders.json
SALES_DB_FILE=./src/database/sales.json

# ---------- SAÚDE DO AGENT E BACKUP EXTERNO ----------
# Agent offline após 120 s sem contacto; SIM antigo após 45 min sem leitura.
DEVICE_OFFLINE_AFTER_SEC=120
SIM_TELEMETRY_STALE_MIN=45
# Alertas em mensagem privada para este número internacional (sem +).
OWNER_NUMBER=
# Cloudflare Workers KV: token com acesso mínimo de leitura/escrita apenas ao namespace escolhido.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=089a3873b8254393b6a9b91a9cc32d46
CLOUDFLARE_API_TOKEN=
# 32 bytes aleatórios em Base64. Guardar separadamente do servidor e do token.
OFFSITE_BACKUP_ENCRYPTION_KEY_BASE64=
OFFSITE_BACKUP_INTERVAL_MIN=60
OFFSITE_BACKUP_RETENTION_DAYS=7
OFFSITE_BACKUP_CHUNK_BYTES=8388608
OFFSITE_BACKUP_INCLUDE_SESSION=true
OFFSITE_BACKUP_SESSION_DIR=./sessions/principal
OFFSITE_BACKUP_PREFIX=ursinho-x/backup
